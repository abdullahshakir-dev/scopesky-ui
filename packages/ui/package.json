{
  "name": "@scopesky/ui",
  "version": "2.1.0",
  "description": "ScopeSky design system for React: 80+ hand-written components styled with Tailwind CSS v4, ScopeSky color tokens, light and dark themes, Arabic / RTL support and 95 SVG icons. No third-party UI dependencies.",
  "keywords": [
    "scopesky",
    "react",
    "tailwindcss",
    "tailwind",
    "components",
    "design-system",
    "ui",
    "rtl",
    "arabic",
    "icons",
    "nextjs"
  ],
  "author": "ScopeSky Communications",
  "homepage": "https://github.com/abdullahshakir-dev/scopesky-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdullahshakir-dev/scopesky-ui.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/abdullahshakir-dev/scopesky-ui/issues"
  },
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "icons",
    "styles.css",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "default": "./dist/button.js"
    },
    "./conversation": {
      "types": "./dist/conversation.d.ts",
      "default": "./dist/conversation.js"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "default": "./dist/data.js"
    },
    "./feedback": {
      "types": "./dist/feedback.d.ts",
      "default": "./dist/feedback.js"
    },
    "./fields": {
      "types": "./dist/fields.d.ts",
      "default": "./dist/fields.js"
    },
    "./navigation": {
      "types": "./dist/navigation.d.ts",
      "default": "./dist/navigation.js"
    },
    "./overlays": {
      "types": "./dist/overlays.d.ts",
      "default": "./dist/overlays.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "default": "./dist/hooks.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "default": "./dist/icons.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.js"
    },
    "./styles.css": "./styles.css",
    "./icons/*.svg": "./icons/*.svg",
    "./package.json": "./package.json"
  },
  "scripts": {
    "icons": "node scripts/build-icons.mjs",
    "build": "node scripts/build-icons.mjs && node scripts/clean.mjs && tsc -p tsconfig.json",
    "dev": "node scripts/build-icons.mjs && tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "node scripts/build-icons.mjs && tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
